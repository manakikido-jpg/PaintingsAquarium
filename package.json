{
  "name": "paintings-aquarium",
  "version": "0.1.0",
  "private": true,
  "description": "紙に描いた絵を、フォルダに置くだけで大画面の水槽に泳がせる（完全オフライン）",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
